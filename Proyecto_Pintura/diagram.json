    ["drvX:RESET", "drvX:SLEEP", "green", []],
    ["motorX:A+", "drvX:1A", "green", []],
    ["motorX:A-", "drvX:1B", "green", []],
    ["motorX:B+", "drvX:2A", "green", []],
    ["motorX:B-", "drvX:2B", "green", []],
    ["esp:21", "drvY:STEP", "orange", []],
    ["esp:22", "drvY:DIR", "blue", []],
    ["esp:3V3", "drvY:VDD", "red", []],
    ["esp:5V", "drvY:VMOT", "red", []],
    ["esp:GND.1", "drvY:GND.1", "black", []],
    ["esp:GND.1", "drvY:GND.2", "black", []],
    ["esp:GND.1", "drvY:ENABLE", "black", []],
    ["drvY:RESET", "drvY:SLEEP", "green", []],
    ["motorY:A+", "drvY:1A", "green", []],
    ["motorY:A-", "drvY:1B", "green", []],
    ["motorY:B+", "drvY:2A", "green", []],
    ["motorY:B-", "drvY:2B", "green", []],
    ["esp:5V", "sensor:VCC", "red", []],
    ["esp:GND.1", "sensor:GND", "black", []],
    ["esp:5", "sensor:TRIG", "green", []],
    ["esp:17", "sensor:ECHO", "purple", []],
    ["esp:23", "estop:1.l", "red", []],
    ["esp:GND.1", "estop:2.l", "black", []],
    ["esp:16", "limitX:1.l", "blue", []],
    ["esp:GND.1", "limitX:2.l", "black", []],
    ["esp:4", "limitY:1.l", "blue", []],
    ["esp:GND.1", "limitY:2.l", "black", []],
