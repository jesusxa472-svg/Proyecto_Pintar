{
  "version": 1,
  "author": "Robot de pintura ESP32",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 100,
      "left": 20,
      "attrs": {}
    },
    {
      "type": "wokwi-a4988",
      "id": "drvX",
      "top": 30,
      "left": 350,
      "attrs": {}
    },
    {
      "type": "wokwi-a4988",
      "id": "drvY",
      "top": 250,
      "left": 350,
      "attrs": {}
    },
    {
      "type": "wokwi-stepper-motor",
      "id": "motorX",
      "top": 10,
      "left": 570,
      "attrs": {
        "size": "17"
      }
    },
    {
      "type": "wokwi-stepper-motor",
      "id": "motorY",
      "top": 230,
      "left": 570,
      "attrs": {
        "size": "17"
      }
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sensor",
      "top": 430,
      "left": 20,
      "attrs": {
        "distance": "150"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "estop",
      "top": 420,
      "left": 230,
      "attrs": {
        "color": "red"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "limitX",
