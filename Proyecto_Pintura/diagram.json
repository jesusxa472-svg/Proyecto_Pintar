    ["esp:3V3", "drvX:VDD", "red", []],
    ["esp:5V", "drvX:VMOT", "red", []],
    ["esp:GND.1", "drvX:GND.1", "black", []],
    ["esp:GND.1", "drvX:GND.2", "black", []],
