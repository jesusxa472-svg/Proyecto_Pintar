    {
      "type": "wokwi-pushbutton",
      "id": "limitY",
      "top": 560,
      "left": 230,
      "attrs": {
        "color": "blue"
      }
    },
    {
      "type": "wokwi-led",
      "id": "pistola",
      "top": 440,
      "left": 430,
      "attrs": {
        "color": "green"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "resPistola",
      "top": 480,
      "left": 430,
      "attrs": {
        "value": "1000"
      }
    }
